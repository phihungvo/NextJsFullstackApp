// Prisma schema for the provisional MySQL 8 domain baseline.
// Product-specific extensions remain subject to product-owner sign-off.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductVisibility {
  PRIVATE
  PUBLIC
}

model User {
  id           String     @id @default(cuid()) @db.VarChar(30)
  email        String     @unique @db.VarChar(320)
  passwordHash String     @db.VarChar(255)
  name         String     @db.VarChar(120)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)
  deletedAt    DateTime?  @db.DateTime(3)

  roles    UserRole[]
  sessions Session[]

  @@index([status, createdAt])
}

model Role {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  users       UserRole[]
  permissions RolePermission[]
}

model Session {
  id         String    @id @default(cuid()) @db.VarChar(30)
  userId     String    @db.VarChar(30)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  lastSeenAt DateTime  @default(now()) @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Permission {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(120)
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  roles RolePermission[]
}

model UserRole {
  userId    String   @db.VarChar(30)
  roleId    String   @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String   @db.VarChar(30)
  permissionId String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Product {
  id          String            @id @default(cuid()) @db.VarChar(30)
  name        String            @db.VarChar(200)
  slug        String            @unique @db.VarChar(220)
  description String?           @db.Text
  price       Decimal           @db.Decimal(12, 2)
  currency    String            @default("USD") @db.Char(3)
  status      ProductStatus     @default(DRAFT)
  visibility  ProductVisibility @default(PRIVATE)
  createdAt   DateTime          @default(now()) @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @db.DateTime(3)
  deletedAt   DateTime?         @db.DateTime(3)

  @@index([status, visibility, createdAt])
  @@index([status, updatedAt])
}
