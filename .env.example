# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistence (configured in Phase 02)
DATABASE_URL=mysql://app_user:change-me@localhost:3306/app_db

# Cache/infrastructure (configured in Phase 02/03)
REDIS_URL=redis://localhost:6379

# Authentication (configured in Phase 03; replace for every environment)
AUTH_SECRET=replace-with-a-long-random-development-secret

# Development seed only; never use these values in shared/production environments.
SEED_ADMIN_PASSWORD=replace-with-a-development-admin-password
SEED_USER_PASSWORD=replace-with-a-development-user-password
