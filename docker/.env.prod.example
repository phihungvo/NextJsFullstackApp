# Copy this file to docker/.env.prod and replace every credential before deployment.
COMPOSE_PROJECT_NAME=nextjs-fullstack-prod
APP_PORT=3000
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
DATABASE_URL=mysql://app_user:replace-with-a-random-database-password@mysql:3306/app_db
NEXT_PUBLIC_APP_URL=https://app.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
