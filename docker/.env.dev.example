# Safe local-only values. Do not reuse these credentials outside development.
COMPOSE_PROJECT_NAME=nextjs-fullstack-dev
APP_PORT=3000
DEBUG_PORT=9229
MYSQL_PORT=3307
REDIS_PORT=6380
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
DATABASE_URL=mysql://app_user:app_password@mysql:3306/app_db
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=local-development-secret-change-this-before-sharing-123456
SEED_ADMIN_PASSWORD=development-admin-password
SEED_USER_PASSWORD=development-user-password
